// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    String  @id @default(uuid()) 
  matricula String  @unique
  name  String?
  password String
  transacoes Transacao[]
  metas Meta[]
  atestados Atestado[]
  contratos Contrato[]
  ajudas Ajuda[]
  denuncias Denuncia[]
} 

model Contrato { 
  id    String  @id @default(uuid()) 
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  empresa String  
  unidade  String?
  curso String
  inicio DateTime
  final DateTime
}

// schema.prisma
model Denuncia {
  id          String   @id @default(uuid())
  userId      String
  categoria   String
  dataOcorido DateTime
  descricao   String   @db.Text
  testemunhas String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("denuncias")
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}
model Transacao {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  categoria String
  valor     Float
  data      DateTime 
  descricao String?
  tipo_transacao    TipoTransacao @default(ENTRADA)
  @@index([userId, tipo_transacao])
}

model Meta {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  meta     String
  valor    Float
  valor_atual     Float
  cor String?
  createdAt   DateTime @default(now())
  @@index([userId])
}
model Ajuda {
  id          String   @id @default(uuid())
  userId      String
  nome        String
  descricao   String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ajudas")
}

model Atestado {
  id          String   @id @default(uuid())
  userId      String
  titulo      String
  descricao   String?
  url         String
  publicId    String
  status      String   @default("em-analise")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("atestados")
}